# ---------------------------------------------------------------------------
# megamall-api/.env on the LIVE server. Copy to /var/www/megamall-api/.env and fill in.
# Never commit the real file to git, never send it on WhatsApp/email.
# ---------------------------------------------------------------------------
APP_NAME="Mega Mall Tanzania"
APP_ENV=production
# Filled by: php artisan key:generate
APP_KEY=
# MUST stay false on the live site (true shows code and passwords on error pages)
APP_DEBUG=false
APP_URL=https://api.megamall.co.tz
APP_TIMEZONE=Africa/Dar_es_Salaam

# The customer shop (Next.js). Used in SMS links, "View in shop" buttons, invoices.
FRONTEND_URL=https://megamall.co.tz

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=megamall
DB_USERNAME=megamall_app
# The long random password printed by server-setup.sh:
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Staff email alerts. Use the client's email provider (Google Workspace, Zoho, cPanel mail...).
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=orders@megamall.co.tz
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@megamall.co.tz
MAIL_FROM_NAME="${APP_NAME}"

# Mobile money. Start with sandbox, switch to live after AzamPay approves the business.
PAYMENT_DRIVER=azampay
AZAMPAY_ENVIRONMENT=live
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
# Any long random text. Register the callback in the AzamPay portal as:
#   https://api.megamall.co.tz/api/payments/callback/azampay?key=THIS_VALUE
AZAMPAY_CALLBACK_KEY=

# SMS: "log" saves messages in the admin SMS outbox only. Change when an SMS provider is connected.
SMS_DRIVER=log
SMS_SENDER_ID=MEGAMALL
